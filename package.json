{
  "name": "smart-park",
  "version": "1.0.0",
  "private": true,
  "description": "SmartPark - real-time smart parking platform (SIH 2026)",
  "scripts": {
    "start": "npm run clean -s && concurrently -n api,web -c blue,green \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
