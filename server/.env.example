# Server
PORT=5000

# MongoDB Atlas
# 1. Atlas dashboard → your cluster → Connect → Drivers → copy the string
# 2. Replace <password> with the DB user's real password
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&writable=majority

# Auth
JWT_SECRET=replace-with-a-long-random-string

# Occupancy simulator (demo vision module)
SIMULATOR_ENABLED=true
SIM_INTERVAL_MS=5000
